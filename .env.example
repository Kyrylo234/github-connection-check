# Values from an independent Supabase project (server-only)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your-project-secret-key
# Optional AI classification and Scenario Lab feedback (server-only)
GEMINI_API_KEY=your-gemini-api-key
# Optional deterministic external location fallback (server-only).
# Local gazetteer matches are always attempted first. Use a descriptive User-Agent.
GEOCODER_USER_AGENT=SitRep/1.0 (contact@example.com)
# Optional endpoint override; defaults to Nominatim's JSON search endpoint.
# GEOCODER_URL=https://nominatim.openstreetmap.org/search
